@{
    ViewData["Title"] = "Orders";
}

<div class="page-header">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h1>📋 Order Management</h1>
                <p class="subtitle">Process and manage customer orders</p>
            </div>
            <a asp-action="Create" class="btn btn-success btn-lg">
                <i class="fas fa-plus"></i> Create Order
            </a>
        </div>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle"></i> @TempData["ErrorMessage"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

<div class="row">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <span class="emoji">📨</span> Order Queue
                <span class="badge badge-light float-right" id="orderCount">@ViewBag.OrderCount</span>
            </div>
            <div class="card-body">
                @if (ViewBag.OrderMessages != null && ViewBag.OrderMessages.Count > 0)
                {
                    foreach (var order in ViewBag.OrderMessages)
                    {
                        <div class="card mb-2">
                            <div class="card-body py-2">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <strong>Order:</strong> @order.OrderId
                                        <br>
                                        <small>Customer: @order.CustomerName</small>
                                        <br>
                                        <small>Total: @order.TotalAmount.ToString("C")</small>
                                    </div>
                                    <div>
                                        <span class="badge badge-warning">@order.Status</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center py-4">
                        <i class="fas fa-inbox" style="font-size: 2rem; color: #ccc;"></i>
                        <p class="mt-2 text-muted">No orders in queue</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <span class="emoji">📦</span> Inventory Queue
                <span class="badge badge-light float-right" id="inventoryCount">@ViewBag.InventoryCount</span>
            </div>
            <div class="card-body">
                @if (ViewBag.InventoryMessages != null && ViewBag.InventoryMessages.Count > 0)
                {
                    foreach (var msg in ViewBag.InventoryMessages)
                    {
                        <div class="card mb-2">
                            <div class="card-body py-2">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <strong>Product:</strong> @msg.MessageText
                                        <br>
                                        <small>Queued: @msg.InsertionTime?.ToString("yyyy-MM-dd HH:mm")</small>
                                    </div>
                                    <div>
                                        <span class="badge badge-info">Pending</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center py-4">
                        <i class="fas fa-inbox" style="font-size: 2rem; color: #ccc;"></i>
                        <p class="mt-2 text-muted">No inventory updates</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>