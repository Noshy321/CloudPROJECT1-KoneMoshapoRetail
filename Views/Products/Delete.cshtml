@model KoneMoshapoRetail.Models.ProductInfo

@{
    ViewData["Title"] = "Delete Product";
}

<div class="page-header">
    <div class="container">
        <h1>🗑️ Delete Product</h1>
        <p class="subtitle">Are you sure you want to delete this product?</p>
    </div>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle"></i> @TempData["ErrorMessage"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card border-danger">
            <div class="card-header bg-danger text-white">
                <i class="fas fa-exclamation-triangle"></i> Confirm Deletion
            </div>
            <div class="card-body">
                <div class="text-center mb-4">
                    <i class="fas fa-box" style="font-size: 4rem; color: #dc3545;"></i>
                </div>

                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <div class="text-center mb-3">
                        <img src="@Model.ImageUrl" style="width: 150px; height: 150px; object-fit: cover; border-radius: 8px;" />
                    </div>
                }

                <div class="table-responsive">
                    <table class="table table-bordered">
                        <tr>
                            <th>Product Name</th>
                            <td>@Model.ProductName</td>
                        </tr>
                        <tr>
                            <th>Category</th>
                            <td>@Model.Category</td>
                        </tr>
                        <tr>
                            <th>Brand</th>
                            <td>@Model.Brand</td>
                        </tr>
                        <tr>
                            <th>Price</th>
                            <td>@Model.Price.ToString("C")</td>
                        </tr>
                        <tr>
                            <th>Stock</th>
                            <td>@Model.StockQuantity</td>
                        </tr>
                        <tr>
                            <th>Status</th>
                            <td>
                                @if (Model.IsAvailable)
                                {
                                    <span class="badge badge-success">Available</span>
                                }
                                else
                                {
                                    <span class="badge badge-danger">Unavailable</span>
                                }
                            </td>
                        </tr>
                    </table>
                </div>

                <div class="alert alert-warning">
                    <i class="fas fa-exclamation-circle"></i>
                    This action cannot be undone. This will permanently delete this product and all associated data.
                </div>

                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="PartitionKey" />
                    <input type="hidden" asp-for="RowKey" />
                    <div class="text-center">
                        <button type="submit" class="btn btn-danger btn-lg px-5">
                            <i class="fas fa-trash"></i> Delete Product
                        </button>
                        <a asp-action="Index" class="btn btn-secondary btn-lg px-5">
                            <i class="fas fa-arrow-left"></i> Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>