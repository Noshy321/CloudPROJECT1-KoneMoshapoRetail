@model KoneMoshapoRetail.Models.CustomerProfile

@{
    ViewData["Title"] = "Delete Customer";
}

<div class="page-header">
    <div class="container">
        <h1>🗑️ Delete Customer</h1>
        <p class="subtitle">Are you sure you want to delete this customer?</p>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card border-danger">
            <div class="card-header bg-danger text-white">
                <i class="fas fa-exclamation-triangle"></i> Confirm Deletion
            </div>
            <div class="card-body">
                <div class="text-center mb-4">
                    <i class="fas fa-user-times" style="font-size: 4rem; color: #dc3545;"></i>
                </div>

                <div class="table-responsive">
                    <table class="table table-bordered">
                        <tr>
                            <th>Name</th>
                            <td>@Model.CustomerName</td>
                        </tr>
                        <tr>
                            <th>Email</th>
                            <td>@Model.Email</td>
                        </tr>
                        <tr>
                            <th>Phone</th>
                            <td>@Model.Phone</td>
                        </tr>
                        <tr>
                            <th>Type</th>
                            <td>@Model.CustomerType</td>
                        </tr>
                        <tr>
                            <th>Status</th>
                            <td>@(Model.IsActive ? "Active" : "Inactive")</td>
                        </tr>
                        <tr>
                            <th>Orders</th>
                            <td>@Model.TotalOrders</td>
                        </tr>
                    </table>
                </div>

                <div class="alert alert-warning">
                    <i class="fas fa-exclamation-circle"></i>
                    This action cannot be undone. This will permanently delete this customer and all associated data.
                </div>

                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="PartitionKey" />
                    <input type="hidden" asp-for="RowKey" />
                    <div class="text-center">
                        <button type="submit" class="btn btn-danger btn-lg px-5">
                            <i class="fas fa-trash"></i> Delete Customer
                        </button>
                        <a asp-action="Index" class="btn btn-secondary btn-lg px-5">
                            <i class="fas fa-arrow-left"></i> Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>